<Project Sdk="Microsoft.NET.Sdk">

  <!-- Porte do verificador de tipos da forge para F#.

       Sem dependência de pacote: só a biblioteca padrão de F# e do .NET. É a
       mesma regra dos outros portes deste portfólio.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>forge_check</AssemblyName>
    <RootNamespace>ForgeCheck</RootNamespace>

    <!-- Exaustividade de casamento de padrões é AVISO em F# (FS0025), e não
         erro como em OCaml quando se promove o aviso. Sem promover aqui, um
         caso faltando compila e explode em execução, que é exatamente o que o
         sistema de tipos deveria impedir.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Evita baixar recursos de idioma e normalização ICU que o porte não
         usa, e mantém a saída determinística entre máquinas.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ForgeCheck.fs" />
  </ItemGroup>

</Project>
